# Прод-nginx (задача 043, п.6). Шаблон: официальный образ nginx подставляет
# ${APP_HOST} и ${ADMIN_LISTEN} из окружения (docker-compose.prod.yml).

# --- 80: проверка домена Let's Encrypt + редирект на https ---------------------
server {
    listen 80;
    server_name ${APP_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- 443: приложение (веб логиста/водителя), API, файлы ------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};

    ssl_certificate     /etc/letsencrypt/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 10m;   # загрузки: 8 МБ на файл (uploads.controller)

    # API и WebSocket
    # Ссылка-приглашение https://<APP_HOST>/invite/<token> открывает приложение
    # (042 п.2): iOS universal links и Android App Links проверяют эти файлы.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        return 200 '{"applinks":{"apps":[],"details":[{"appIDs":["${IOS_APP_ID}"],"paths":["/invite/*","/c/*","/co/*","/d/*","/open/*"],"components":[{"/":"/invite/*"},{"/":"/c/*"},{"/":"/co/*"},{"/":"/d/*"},{"/":"/open/*"}]}]}}';
    }
    location = /.well-known/assetlinks.json {
        default_type application/json;
        return 200 '[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"${ANDROID_PACKAGE}","sha256_cert_fingerprints":["${ANDROID_CERT_SHA256}"]}}]';
    }

    location /api/ {
        proxy_pass http://backend:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /socket.io/ {
        proxy_pass http://backend:3000/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Публичные фото грузов (бакет lubao-uploads). Бакет документов (персональные
    # данные) наружу НЕ публикуется — его отдаёт только бэкенд админу.
    location /files/lubao-uploads/ {
        proxy_pass http://minio:9000/lubao-uploads/;
        proxy_set_header Host minio:9000;
        proxy_hide_header Set-Cookie;
        limit_except GET HEAD { deny all; }
    }

    # Юридические страницы (тексты-заготовки на 4 языках, юрист правит).
    location /legal/ {
        root /srv/site;
        try_files $uri $uri.html =404;
        default_type text/html;
        add_header Cache-Control "public, max-age=300";
    }

    # Страница обновления «Скачать приложение» (force-update, задача 043, п.7).
    location = /app {
        root /srv/site;
        try_files /app.html =404;
        default_type text/html;
    }

    # 052: публичные страницы «Поделиться» /c|co|d/<код> — HTML бэкенда (без
    # входа). Установленное приложение перехватывает эти пути раньше (App Links).
    location ~ "^/(c|co|d)/[A-Za-z0-9]{4,12}$" {
        proxy_pass http://backend:3000/p$request_uri;
        proxy_set_header Host $host;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Веб логиста: путь без «#» (usePathUrlStrategy) → любой неизвестный путь,
    # в том числе /invite/<токен>, отдаёт index.html, дальше маршрутизирует Flutter.
    # CanvasKit и шрифты — свои, из сборки (--no-web-resources-cdn), без gstatic.
    location / {
        root /srv/app;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
    # Запасные шрифты движка не хостим (иероглифы — из вшитого Noto Sans SC):
    # честный 404, а не index.html, который движок принял бы за шрифт.
    location /fonts/fallback/ {
        return 404;
    }
    location ~* \.(js|wasm|ttf|otf|woff2|png|jpg|ico)$ {
        root /srv/app;
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public";
    }
}

# --- Админка: слушает ТОЛЬКО адрес Tailscale (задача 030, п.11) ----------------
# Снаружи (с публичного IP) не открывается; доступ — через tailnet. Транспорт
# уже зашифрован WireGuard, поэтому здесь без отдельного TLS.
server {
    listen ${ADMIN_LISTEN};
    server_name _;

    location /api/ {
        proxy_pass http://backend:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location / {
        root /srv/admin;
        try_files $uri $uri/ /index.html;
    }
}
