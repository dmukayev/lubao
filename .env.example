# Postgres
POSTGRES_USER=lubao
POSTGRES_PASSWORD=lubao
POSTGRES_DB=lubao
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Minio (S3-совместимое хранилище файлов)
MINIO_ROOT_USER=lubao
MINIO_ROOT_PASSWORD=lubao_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lubao-uploads
# Адрес, по которому MinIO доступен снаружи (для ссылок на фото, отдаваемых клиентам)
MINIO_PUBLIC_URL=http://localhost:9000

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://lubao:lubao@postgres:5432/lubao?schema=public
REDIS_URL=redis://redis:6379

# SMS: console (dev, код всегда 1111, пишет в лог) | mobizon (прод)
SMS_PROVIDER=console
MOBIZON_API_KEY=
MOBIZON_API_URL=https://api.mobizon.kz/service/message/sendsmsmessage

# Nginx
NGINX_PORT=80

# JWT (access-токен, 15 мин). Обязателен, без дефолта.
JWT_ACCESS_SECRET=

# Окружение: на деве/пилоте не задавать, на проде обязательно NODE_ENV=production
# (иначе демо-сид можно запустить по ошибке на проде).
NODE_ENV=development
