DATABASE_URL=postgresql://lubao:lubao@localhost:5432/lubao?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lubao
MINIO_SECRET_KEY=lubao_minio_password
MINIO_BUCKET=lubao-uploads
MINIO_PUBLIC_URL=http://localhost:9000

# console (dev, код всегда 1111, пишет в лог) | mobizon (прод, реальная SMS)
SMS_PROVIDER=console
MOBIZON_API_KEY=
MOBIZON_API_URL=https://api.mobizon.kz/service/message/sendsmsmessage
# Каналы кода входа (042 п.3): какие включены и порядок — в админке (Настройки).
# Без ключей канал недоступен и показан в админке серым.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ru
TELEGRAM_GATEWAY_TOKEN=
# Только dev/e2e: каналы без ключей, код пишется в консоль (в production игнорируется).
LOGIN_CODE_CONSOLE_CHANNELS=
# Push (042 п.1, docs/release.md раздел 5). console — пишет в лог; real — FCM/APNs.
PUSH_PROVIDER=console
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=28Y4B2FLZ7
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=kz.darkhan.lubao
APNS_PRODUCTION=false

# JWT (access-токен, 15 мин). Обязателен, без дефолта.
JWT_ACCESS_SECRET=

# Задача 031 — шифрование/хэширование идентификаторов (ИИН, номер прав) в
# чёрном списке. Обязательны, без дефолта.
IDENTIFIER_PEPPER=
IDENTIFIER_KEY=

# Задача 031, этап D — OCR-сервис распознавания документов (infra/ocr/),
# внутри docker-сети, без публичного порта. Не задано — распознавание
# пропускается (DocumentRecognition.status=SKIPPED).
OCR_SERVICE_URL=http://ocr:8000

# noop (дефолт, перевод выключен — translationStatus=SKIPPED) | deepseek (прод)
TRANSLATION_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Список через запятую — сузить CORS до этих origin (задача 030, п.11:
# проверка админки с телефона через Tailscale). Не задано — CORS открыт
# для всех (как раньше), подходит для обычной локальной разработки.
# Пример: http://my-mac.tailnet-name.ts.net:5566,http://192.168.1.50:5566
CORS_ALLOWED_ORIGINS=
