generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  DRIVER
  COMPANY
  ADMIN
}

enum Locale {
  kk
  ru
  zh
  en
}

enum CompanyMemberRole {
  OWNER
  LOGIST
}

enum ArrivalStatus {
  PLANNED
  ON_SITE
  COMPLETED
  CANCELLED
}

enum CargoStatus {
  PUBLISHED
  ARCHIVED
  EXPIRED
  CANCELLED
}

/// Закрытие груза без выбора исхода запрещено (задача 017, п.6).
enum CargoCloseOutcome {
  FOUND_IN_APP
  FOUND_OUTSIDE
  CARGO_CANCELLED
}

enum Currency {
  USD
  CNY
  KZT
}

enum ResponseStatus {
  PENDING
  SELECTED
  REJECTED
  CANCELLED
}

enum DealStatus {
  SELECTED
  CONFIRMED_BY_DRIVER
  LOADED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ContactEventType {
  CALL
  WHATSAPP
}

enum ReviewAuthorRole {
  DRIVER
  COMPANY
  /// Только для `Deal.cancelledByRole` — отмена сделки админом (задача 028,
  /// п.17). Отзывов от имени админа не существует, `Review.authorRole`
  /// этого значения никогда не получит.
  ADMIN
}

enum VerificationDocType {
  DRIVER_LICENSE
  VEHICLE_PASSPORT
  TRAILER_PASSPORT
  SELFIE
  COMPANY_REGISTRATION
  IDENTITY
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  PUSH
  WECOM
  EMAIL
  SMS
}

enum ComplaintTargetType {
  USER
  COMPANY
  CARGO
  DEAL
  CHAT_MESSAGE
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentType {
  SUBSCRIPTION
  DEAL_FEE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Справочники. Названия — Json {kk, ru, zh}: новый язык (например kk-Latn)
// добавляется как новый ключ в JSON, без миграции схемы.
// ---------------------------------------------------------------------------

model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        Json
  isCisMember Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions            Region[]
  cities             City[]
  companies          Company[]
  driverDirections   DriverDirection[]
  arrivalDirections  ArrivalDirection[]
  cargoDestinations  Cargo[]

  @@map("countries")
}

model Region {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      Json
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@unique([countryId, code])
  @@index([countryId])
  @@map("regions")
}

model City {
  id                String     @id @default(uuid())
  countryId         String
  country           Country    @relation(fields: [countryId], references: [id])
  regionId          String?
  region            Region?    @relation(fields: [regionId], references: [id])
  code              String?    @unique
  name              Json
  isCapital         Boolean    @default(false)
  lat               Decimal?   @db.Decimal(9, 6)
  lng               Decimal?   @db.Decimal(9, 6)
  cityStatus        CityStatus @default(APPROVED)
  submittedByUserId String?
  submittedBy       User?      @relation("CitySubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedBy        User?      @relation("CityReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  points             Point[]
  driversHomeCity    Driver[]
  cargoDestinations  Cargo[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityStatus])
  @@map("cities")
}

model Point {
  id        String   @id @default(uuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  name      Json
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arrivals Arrival[]
  cargos   Cargo[]

  @@index([cityId])
  @@map("points")
}

model BodyType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
  cargos   Cargo[]

  @@map("body_types")
}

model Permit {
  id        String   @id @default(uuid())
  code      String   @unique
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverPermits DriverPermit[]

  @@map("permits")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  category  String
  text      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Пользователи и профили
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  role            UserRole
  phone           String?   @unique
  email           String?   @unique
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  locale          Locale    @default(ru)
  isActive        Boolean   @default(true)
  isBlocked       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driver                 Driver?
  companyMember          CompanyMember?
  sentMessages           Message[]
  contactEventsAsActor   ContactEvent[]      @relation("ContactEventActor")
  reviewsAuthored        Review[]
  verificationDocuments  VerificationDocument[]
  notificationSettings   NotificationSetting[]
  notificationEventSettings NotificationEventSetting[]
  deviceTokens           DeviceToken[]
  complaintsFiled        Complaint[]         @relation("ComplaintReporter")
  complaintsResolved     Complaint[]         @relation("ComplaintResolver")
  complaintsAssigned     Complaint[]         @relation("ComplaintAssignee")
  auditLogs              AuditLog[]
  reviewedDocuments      VerificationDocument[] @relation("VerificationDocumentReviewer")
  sessions               Session[]
  citiesSubmitted        City[]                  @relation("CitySubmittedBy")
  citiesReviewed         City[]                  @relation("CityReviewedBy")
  companyInvitesSent     CompanyInvite[]
  cargosPublished        Cargo[]                 @relation("CargoPublishedBy")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  refreshTokenHash  String    @unique
  previousTokenHash String?   @unique
  deviceName        String?
  platform          String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId])
  @@map("sessions")
}

model Driver {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  fullName     String
  homeCityId   String
  homeCity     City     @relation(fields: [homeCityId], references: [id])
  anyCountry   Boolean  @default(false)
  isVerified   Boolean  @default(false)
  ratingAvg    Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount  Int      @default(0)
  currentLat        Decimal?  @db.Decimal(9, 6)
  currentLng        Decimal?  @db.Decimal(9, 6)
  locationUpdatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  directions           DriverDirection[]
  permits              DriverPermit[]
  vehicles             Vehicle[]
  arrivals             Arrival[]
  responses            Response[]
  deals                Deal[]
  chats                Chat[]
  contactEvents        ContactEvent[]
  verificationDocuments VerificationDocument[] @relation("DriverVerificationDocuments")
  payments             Payment[]

  @@index([homeCityId])
  @@map("drivers")
}

model DriverDirection {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  createdAt DateTime @default(now())

  @@unique([driverId, countryId])
  @@map("driver_directions")
}

model DriverPermit {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  permitId  String
  permit    Permit   @relation(fields: [permitId], references: [id])
  createdAt DateTime @default(now())

  @@unique([driverId, permitId])
  @@map("driver_permits")
}

model Vehicle {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  bodyTypeId    String
  bodyType      BodyType @relation(fields: [bodyTypeId], references: [id])
  plateNumber   String?
  brand         String?
  capacityTons  Decimal? @db.Decimal(6, 2)
  lengthM       Decimal? @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([driverId])
  @@index([bodyTypeId])
  @@map("vehicles")
}

model Company {
  id            String   @id @default(uuid())
  name          String
  nameRu        String?
  countryId     String
  country       Country  @relation(fields: [countryId], references: [id])
  city          String?
  legalAddress  String?
  taxId         String?
  /// Вебхук группового бота WeCom (задача 011, п.2) — владелец вставляет
  /// адрес в профиле компании; «Проверить» шлёт туда тестовое сообщение.
  wecomWebhookUrl String?
  isVerified    Boolean  @default(false)
  /// Блокировка компании целиком (задача 026, п.5) — отдельно от
  /// User.isBlocked у каждого сотрудника: блокировка компании блокирует
  /// всех её участников И скрывает активные грузы из ленты водителя.
  isBlocked     Boolean  @default(false)
  ratingAvg     Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members               CompanyMember[]
  cargos                Cargo[]
  deals                 Deal[]
  chats                 Chat[]
  contactEvents         ContactEvent[]
  arrivalViews          ArrivalView[]
  invites               CompanyInvite[]
  verificationDocuments VerificationDocument[] @relation("CompanyVerificationDocuments")
  subscriptions         Subscription[]
  payments              Payment[]

  @@index([countryId])
  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id])
  role      CompanyMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([companyId])
  @@map("company_members")
}

/// Приглашение сотрудника по ссылке (задача 025, «Путь Б» из 022): владелец
/// отправляет email+роль, получает одноразовый токен, действующий 7 дней.
/// Переход по ссылке подтверждает email автоматически.
model CompanyInvite {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  invitedByUserId String
  invitedBy       User              @relation(fields: [invitedByUserId], references: [id])
  email           String
  role            CompanyMemberRole
  token           String            @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime          @default(now())

  @@index([companyId])
  @@index([token])
  @@map("company_invites")
}

// ---------------------------------------------------------------------------
// Груз и сделки
// ---------------------------------------------------------------------------

/// Анонс прибытия (задача 015 — ядро продукта): водитель сообщает, что
/// будет на точке в будущем (`plannedAt`, до +14 дней), не только «сейчас».
/// Один активный (PLANNED/ON_SITE) анонс на водителя — новый вызов
/// announce() заменяет предыдущий, а не плодит дубли.
model Arrival {
  id         String        @id @default(uuid())
  driverId   String
  driver     Driver        @relation(fields: [driverId], references: [id])
  pointId    String
  point      Point         @relation(fields: [pointId], references: [id])
  plannedAt  DateTime
  arrivedAt  DateTime?
  waitDays   Int           @default(2)
  anyCountry Boolean       @default(false)
  status     ArrivalStatus @default(PLANNED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  directions ArrivalDirection[]
  views      ArrivalView[]

  @@index([driverId])
  @@index([pointId, status])
  @@index([status, plannedAt])
  @@map("arrivals")
}

/// Страны на конкретную поездку (п. 12 задачи 015) — может отличаться от
/// постоянных направлений в профиле водителя (`DriverDirection`).
model ArrivalDirection {
  id        String  @id @default(uuid())
  arrivalId String
  arrival   Arrival @relation(fields: [arrivalId], references: [id])
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  @@unique([arrivalId, countryId])
  @@map("arrival_directions")
}

/// Счётчик «N логистов посмотрели» (п. 8 задачи 015) — уникальные компании,
/// не количество открытий.
model ArrivalView {
  id        String   @id @default(uuid())
  arrivalId String
  arrival   Arrival  @relation(fields: [arrivalId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  viewedAt  DateTime @default(now())

  @@unique([arrivalId, companyId])
  @@map("arrival_views")
}

/// Настройки приложения уровня ключ-значение, редактируются в админке
/// (задача 015: `defaultPointCityId`). Значение — всегда строка; парсинг на
/// стороне использующего кода.
model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model Cargo {
  id                    String      @id @default(uuid())
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id])
  /// Логист, опубликовавший груз (decisions.md «Компания: проверка, роли,
  /// контакты», задача 012: «водитель звонит конкретному логисту, а не
  /// компании») — водитель видит и звонит именно ему, не владельцу
  /// компании. `NULL` у грузов, опубликованных до задачи 017 — на чтении
  /// падаем на владельца компании.
  publishedByUserId     String?
  publishedBy           User?       @relation("CargoPublishedBy", fields: [publishedByUserId], references: [id])
  pointId               String
  point                 Point       @relation(fields: [pointId], references: [id])
  destinationCountryId  String
  destinationCountry    Country     @relation(fields: [destinationCountryId], references: [id])
  destinationCityId     String?
  destinationCity       City?       @relation(fields: [destinationCityId], references: [id])
  bodyTypeId            String
  bodyType              BodyType    @relation(fields: [bodyTypeId], references: [id])
  weightKg              Decimal?    @db.Decimal(10, 2)
  volumeM3              Decimal?    @db.Decimal(7, 2)
  photoUrls             String[]    @default([])
  price                 Decimal     @db.Decimal(12, 2)
  currency              Currency
  readyDate             DateTime
  description           String?
  status                CargoStatus @default(PUBLISHED)
  publishedAt           DateTime    @default(now())
  expiresAt             DateTime
  archivedAt            DateTime?
  /// Исход закрытия (задача 017, п.6/7) — метрика утечки сделок мимо
  /// приложения, тот же смысл, что у аналогичной метрики анонсов (014).
  closeOutcome          CargoCloseOutcome?
  closedAt              DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  responses      Response[]
  deals          Deal[]
  chats          Chat[]
  contactEvents  ContactEvent[]

  @@index([status, pointId, destinationCountryId])
  @@index([companyId])
  @@map("cargos")
}

model Response {
  id        String         @id @default(uuid())
  cargoId   String
  cargo     Cargo          @relation(fields: [cargoId], references: [id])
  driverId  String
  driver    Driver         @relation(fields: [driverId], references: [id])
  message   String?
  status    ResponseStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  deal Deal?

  @@unique([cargoId, driverId])
  @@index([cargoId])
  @@map("responses")
}

model Deal {
  id                 String     @id @default(uuid())
  responseId         String     @unique
  response           Response   @relation(fields: [responseId], references: [id])
  cargoId            String
  cargo              Cargo      @relation(fields: [cargoId], references: [id])
  driverId           String
  driver             Driver     @relation(fields: [driverId], references: [id])
  companyId          String
  company             Company   @relation(fields: [companyId], references: [id])
  status             DealStatus @default(SELECTED)
  cancelReason       String?
  cancelledByRole    ReviewAuthorRole?
  confirmedAt        DateTime?
  loadedAt           DateTime?
  inTransitAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  contactEvents ContactEvent[]
  chats         Chat[]
  reviews       Review[]
  payments      Payment[]

  @@index([status])
  @@index([driverId])
  @@index([companyId])
  @@map("deals")
}

model ContactEvent {
  id         String           @id @default(uuid())
  driverId   String
  driver     Driver           @relation(fields: [driverId], references: [id])
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  cargoId    String?
  cargo      Cargo?           @relation(fields: [cargoId], references: [id])
  dealId     String?
  deal       Deal?            @relation(fields: [dealId], references: [id])
  actorUserId String
  actor      User             @relation("ContactEventActor", fields: [actorUserId], references: [id])
  type       ContactEventType
  createdAt  DateTime         @default(now())

  @@index([driverId])
  @@index([companyId])
  @@map("contact_events")
}

model Chat {
  id        String   @id @default(uuid())
  cargoId   String?
  cargo     Cargo?   @relation(fields: [cargoId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([driverId])
  @@index([companyId])
  @@map("chats")
}

/// Автоперевод (задача 010) — SKIPPED: не нужен (получатель пишет на том
/// же языке), DONE: перевод(ы) в `translations`, FAILED: провайдер
/// недоступен/таймаут — сообщение доставлено с оригиналом, клиент
/// показывает «Перевод недоступен · повторить».
enum TranslationStatus {
  SKIPPED
  /// В очереди/переводится в фоне (задача 029, п.6) — сообщение уже
  /// доставлено с оригиналом, перевод подъедет отдельным событием
  /// `message:translated`, отправка не ждёт DeepSeek.
  PENDING
  DONE
  FAILED
}

model Message {
  id                String            @id @default(uuid())
  chatId            String
  chat              Chat              @relation(fields: [chatId], references: [id])
  senderUserId      String
  sender            User              @relation(fields: [senderUserId], references: [id])
  originalText      String
  originalLang      Locale
  translations      Json?
  translationStatus TranslationStatus @default(SKIPPED)
  isRead            Boolean           @default(false)
  createdAt         DateTime          @default(now())

  @@index([chatId, createdAt])
  @@map("messages")
}

/// Метрика расхода (задача 010, п.8) — «Настройки → Перевод» в админке:
/// включён/выключен, модель, расход за 7 дней. Одна строка на один вызов
/// провайдера (не на сообщение — ретрай пишет вторую строку).
model TranslationLog {
  id           String   @id @default(uuid())
  provider     String
  model        String?
  success      Boolean
  tokensUsed   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("translation_logs")
}

model Review {
  id             String           @id @default(uuid())
  dealId         String
  deal           Deal             @relation(fields: [dealId], references: [id])
  authorUserId   String
  author         User             @relation(fields: [authorUserId], references: [id])
  authorRole     ReviewAuthorRole
  rating         Int
  comment        String?
  createdAt      DateTime         @default(now())

  @@unique([dealId, authorRole])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Верификация, уведомления, жалобы, курсы, аудит, монетизация
// ---------------------------------------------------------------------------

model VerificationDocument {
  id               String              @id @default(uuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  driverId         String?
  driver           Driver?             @relation("DriverVerificationDocuments", fields: [driverId], references: [id])
  companyId        String?
  company          Company?            @relation("CompanyVerificationDocuments", fields: [companyId], references: [id])
  type             VerificationDocType
  fileUrl          String
  status           VerificationStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?               @relation("VerificationDocumentReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("verification_documents")
}

model NotificationSetting {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel])
  @@map("notification_settings")
}

/// Группа событий (задача 011, п.4) — отдельная ось от NotificationSetting:
/// там "включён ли канал вообще" (push/wecom/email/sms), здесь "хочу ли я
/// именно эти уведомления". notify() шлёт, только если ОБЕ оси включены
/// (или для оси, по которой строки ещё нет — дефолт true у обеих).
enum NotificationEventGroup {
  NEW_CARGO_MATCH
  CARGO_INVITE
  CHAT_MESSAGE
  NEW_RESPONSE
  NEW_DRIVER_DIGEST
  DEAL_STATUS
  VERIFICATION
  AGREED_CHECK
  /// Снятие груза/решение по жалобе админом (задача 029, п.7) — раньше
  /// только NOTIFICATION_QUEUED в audit_log без реальной отправки.
  ADMIN_ACTION
}

model NotificationEventSetting {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  eventGroup NotificationEventGroup
  enabled    Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([userId, eventGroup])
  @@map("notification_event_settings")
}

enum DevicePlatform {
  FCM
  APNS
  JPUSH
}

/// Токен устройства для push (задача 011, п.2) — привязан к пользователю,
/// не к Session из 006: сессия живёт 15 мин/до логаута, токен устройства
/// переживает много сессий, обновляется при каждом запуске приложения.
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
  @@map("device_tokens")
}

model Complaint {
  id               String              @id @default(uuid())
  reporterUserId   String
  reporter         User                @relation("ComplaintReporter", fields: [reporterUserId], references: [id])
  targetType       ComplaintTargetType
  targetId         String
  reason           String
  description      String?
  status           ComplaintStatus     @default(OPEN)
  /// Кто взял в работу (задача 028, п.24e) — отдельно от resolvedByUserId,
  /// который ставится только при закрытии.
  assignedToUserId String?
  assignedTo       User?               @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id])
  takenAt          DateTime?
  resolvedByUserId String?
  resolvedBy       User?               @relation("ComplaintResolver", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  /// Решение (п.24b) — `NULL` у старых записей, закрытых до этой миграции.
  resolution       ComplaintResolution?
  /// Ответ автору жалобы — обязателен при закрытии (п.24d), `NULL` у старых.
  resolutionNote   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([targetType, targetId])
  @@map("complaints")
}

enum ComplaintResolution {
  DISMISSED
  WARNED
  CARGO_UNPUBLISHED
  BLOCKED
}

model ExchangeRate {
  id            String   @id @default(uuid())
  currency      Currency
  rateToKzt     Decimal  @db.Decimal(12, 6)
  effectiveDate DateTime @db.Date
  source        String   @default("nbrk")
  createdAt     DateTime @default(now())

  @@unique([currency, effectiveDate])
  @@map("exchange_rates")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_log")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  plan      String             @default("company_monthly")
  priceUsd  Decimal            @default(200) @db.Decimal(8, 2)
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments Payment[]

  @@index([companyId])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id])
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       Currency      @default(USD)
  type           PaymentType
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([driverId])
  @@map("payments")
}
