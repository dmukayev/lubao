generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  DRIVER
  COMPANY
  ADMIN
}

enum Locale {
  kk
  ru
  zh
  en
}

enum CompanyMemberRole {
  OWNER
  LOGIST
}

enum ArrivalStatus {
  PLANNED
  ON_SITE
  COMPLETED
  CANCELLED
  /// Угас сам по правилу свежести (задача 040): не доехал в день приезда /
  /// не ответил на «Ещё ищете груз?» / вышел срок ожидания.
  EXPIRED
}

/// Вид точки погрузки (задача 040): CITY — обычный город (на месте — по
/// нажатию), TERMINAL — терминал/сухой порт с геозоной (Хоргос).
enum PointKind {
  CITY
  TERMINAL
}

/// Гараж водителя (задача 031, этап A): тягач и прицеп проверяются и
/// учитываются по отдельности; RIGID — одиночка (кузов на шасси, без
/// отдельного прицепа), использует те же поля, что и TRAILER.
enum VehicleKind {
  TRACTOR
  TRAILER
  RIGID
}

enum CargoStatus {
  PUBLISHED
  /// Выбран водитель, сделка активна (задача 041): из ленты скрыт, откликаться нельзя.
  IN_DEAL
  ARCHIVED
  EXPIRED
  CANCELLED
}

/// Закрытие груза без выбора исхода запрещено (задача 017, п.6).
enum CargoCloseOutcome {
  FOUND_IN_APP
  FOUND_OUTSIDE
  CARGO_CANCELLED
}

enum Currency {
  USD
  CNY
  KZT
  /// 058 п.4: рейсы в Россию и Узбекистан.
  RUB
  UZS
}

/// 058 п.5: ответ водителя на встречную цену логиста.
enum CounterStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// 058 п.1: форма оплаты груза — наличные / на карту / на счёт (без НДС, решение 2026-10-10).
enum PaymentForm {
  CASH
  CARD
  CASHLESS
}

/// 058 п.8а: метка типа компании (режим «перевозчик с парком» — после пилота).
enum CompanyKind {
  SHIPPER
  FORWARDER
  CARRIER
}

enum ResponseStatus {
  /// Логист пригласил, водитель ещё не согласился (задача 041, п.3).
  INVITED
  PENDING
  SELECTED
  REJECTED
  CANCELLED
}

/// 056 п.1: почему отклик закрыт (REJECTED/CANCELLED) — для «Истории рейсов»
/// водителя. У активных откликов — null.
enum ResponseCloseReason {
  WITHDRAWN
  INVITE_EXPIRED
  CARGO_ARCHIVED
  CARGO_CLOSED
  TAKEN_BY_OTHER
  REJECTED_BY_LOGIST
  DEAL_CANCELLED
  ACCOUNT_DELETED
}

enum DealStatus {
  SELECTED
  CONFIRMED_BY_DRIVER
  LOADED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  /// 046: после «В пути» одна сторона просит отмену, вторая подтверждает или оспаривает.
  CANCEL_REQUESTED
  /// 046: вторая сторона оспорила отмену — решает админ.
  DISPUTED
}

/// 046: на каком этапе отменили — по статусу в момент отмены.
enum CancelStage {
  BEFORE_CONFIRM
  AFTER_CONFIRM
  AFTER_LOAD
  IN_TRANSIT
}

/// 046: чья вина — относительно стороны, отменившей сделку.
enum FaultSide {
  SELF
  OTHER_PARTY
  NEUTRAL
}

enum ContactEventType {
  CALL
  WHATSAPP
}

enum ReviewAuthorRole {
  DRIVER
  COMPANY
  /// Только для `Deal.cancelledByRole` — отмена сделки админом (задача 028,
  /// п.17). Отзывов от имени админа не существует, `Review.authorRole`
  /// этого значения никогда не получит.
  ADMIN
}

enum VerificationDocType {
  DRIVER_LICENSE
  VEHICLE_PASSPORT
  TRAILER_PASSPORT
  SELFIE
  COMPANY_REGISTRATION
  IDENTITY
  OTHER
  /// Фото машины спереди с госномером и сбоку (044 п.7) — логисту в карточке
  /// водителя и в пакете документов на рейс; на проверку не влияют.
  VEHICLE_PHOTO_FRONT
  VEHICLE_PHOTO_SIDE
}

/// Профиль типа кузова (048): какие поля у машины и груза и как отсеивать ленту.
enum BodyTypeProfile {
  VOLUME
  PLATFORM
  CONTAINER
  BULK
  TANK
  CAR_CARRIER
}

/// Кто подтвердил машину (044 п.6): админ вручную или автопроверка техпаспорта.
enum VehicleVerifier {
  ADMIN
  AUTO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  PUSH
  WECOM
  EMAIL
  SMS
}

enum ComplaintTargetType {
  USER
  COMPANY
  CARGO
  DEAL
  CHAT_MESSAGE
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentType {
  SUBSCRIPTION
  DEAL_FEE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Справочники. Названия — Json {kk, ru, zh}: новый язык (например kk-Latn)
// добавляется как новый ключ в JSON, без миграции схемы.
// ---------------------------------------------------------------------------

model Country {
  id          String   @id @default(uuid())
  code        String   @unique
  name        Json
  isCisMember Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions           Region[]
  cities            City[]
  companies         Company[]
  driverDirections  DriverDirection[]
  arrivalDirections ArrivalDirection[]
  cargoDestinations Cargo[]

  @@map("countries")
}

model Region {
  id        String   @id @default(uuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      Json
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@unique([countryId, code])
  @@index([countryId])
  @@map("regions")
}

model City {
  id                String     @id @default(uuid())
  countryId         String
  country           Country    @relation(fields: [countryId], references: [id])
  regionId          String?
  region            Region?    @relation(fields: [regionId], references: [id])
  code              String?    @unique
  name              Json
  isCapital         Boolean    @default(false)
  lat               Decimal?   @db.Decimal(9, 6)
  lng               Decimal?   @db.Decimal(9, 6)
  cityStatus        CityStatus @default(APPROVED)
  submittedByUserId String?
  submittedBy       User?      @relation("CitySubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedByUserId  String?
  reviewedBy        User?      @relation("CityReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  points            Point[]
  driversHomeCity   Driver[]
  cargoDestinations Cargo[]

  @@index([countryId])
  @@index([regionId])
  @@index([cityStatus])
  @@map("cities")
}

model Point {
  id        String    @id @default(uuid())
  cityId    String
  city      City      @relation(fields: [cityId], references: [id])
  name      Json
  lat       Decimal?  @db.Decimal(9, 6)
  lng       Decimal?  @db.Decimal(9, 6)
  kind      PointKind @default(CITY)
  /// Радиус геозоны, м — только для TERMINAL с координатами (задача 040).
  radiusM   Int?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  arrivals Arrival[]
  cargos   Cargo[]

  @@index([cityId])
  @@map("points")
}

model BodyType {
  id        String          @id @default(uuid())
  code      String          @unique
  name      Json
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  /// 048: профиль и поля (JSON: [{key, kind, unit, label, forVehicle, forCargo,
  /// required, primary, min, max, options}]) — правятся в админке без релиза.
  profile   BodyTypeProfile @default(VOLUME)
  fields    Json            @default("[]")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  vehicles           Vehicle[]
  preferredByDrivers Driver[]  @relation("DriverPreferredBodyType")
  cargos             Cargo[]

  @@map("body_types")
}

/// Шаблоны размеров кузова (задача 033) — внутренние размеры/объём/паллеты
/// стандартных полуприцепов; водитель выбирает одним касанием вместо
/// рулетки. Значения ориентировочные, правятся в админке без релиза.
model BodySizePreset {
  id              String   @id @default(uuid())
  code            String   @unique
  name            Json
  /// К каким типам кузова подходит шаблон (пустой массив = ко всем).
  bodyTypeIds     String[] @default([])
  innerLengthM    Decimal? @db.Decimal(5, 2)
  innerWidthM     Decimal? @db.Decimal(4, 2)
  innerHeightM    Decimal? @db.Decimal(4, 2)
  volumeM3        Decimal? @db.Decimal(6, 1)
  palletsEuro     Int?
  palletsStandard Int?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicles Vehicle[]

  @@map("body_size_presets")
}

model Permit {
  id        String   @id @default(uuid())
  code      String   @unique
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverPermits DriverPermit[]

  @@map("permits")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  category  String
  text      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Пользователи и профили
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  role             UserRole
  phone            String?   @unique
  email            String?   @unique
  /// 050: аккаунт Telegram, с которого водитель вошёл через бота, — повторный
  /// вход одной кнопкой «Старт» без контакта.
  telegramUserId   String?   @unique
  passwordHash     String?
  name             String?
  emailVerifiedAt  DateTime?
  locale           Locale    @default(ru)
  isActive         Boolean   @default(true)
  isBlocked        Boolean   @default(false)
  /// Аккаунт удалён самим пользователем (043 п.1): ПДн обезличены, вход
  /// закрыт (isActive=false), сделки и отзывы остаются без имени.
  deletedAt        DateTime?
  /// Согласие на обработку ПДн (043 п.2) — спрашивается перед первой
  /// загрузкой документа; новая версия текста → спросить заново.
  pdConsentAt      DateTime?
  pdConsentVersion String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver                    Driver?
  companyMember             CompanyMember?
  sentMessages              Message[]
  contactEventsAsActor      ContactEvent[]             @relation("ContactEventActor")
  reviewsAuthored           Review[]
  verificationDocuments     VerificationDocument[]
  notificationSettings      NotificationSetting[]
  notificationEventSettings NotificationEventSetting[]
  deviceTokens              DeviceToken[]
  complaintsFiled           Complaint[]                @relation("ComplaintReporter")
  complaintsResolved        Complaint[]                @relation("ComplaintResolver")
  complaintsAssigned        Complaint[]                @relation("ComplaintAssignee")
  auditLogs                 AuditLog[]
  reviewedDocuments         VerificationDocument[]     @relation("VerificationDocumentReviewer")
  sessions                  Session[]
  citiesSubmitted           City[]                     @relation("CitySubmittedBy")
  citiesReviewed            City[]                     @relation("CityReviewedBy")
  companyInvitesSent        CompanyInvite[]
  cargosPublished           Cargo[]                    @relation("CargoPublishedBy")
  identifiersConfirmed      Identifier[]               @relation("IdentifierConfirmedBy")
  identifiersBlocked        BlockedIdentifier[]        @relation("IdentifierBlockedBy")
  identifiersLifted         BlockedIdentifier[]        @relation("IdentifierLiftedBy")

  cargoResponsesSeen CargoResponsesSeen[]

  /// 052: по чьей ссылке пришёл (первый вход по ссылке «Поделиться»).
  referredByShareId String?
  referredByShare   ShareLink?  @relation("ShareLinkReferred", fields: [referredByShareId], references: [id], onDelete: SetNull)
  shareLinks        ShareLink[] @relation("ShareLinkAuthor")

  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  refreshTokenHash  String    @unique
  previousTokenHash String?   @unique
  deviceName        String?
  platform          String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([userId])
  @@map("sessions")
}

model Driver {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  fullName               String
  homeCityId             String
  homeCity               City      @relation(fields: [homeCityId], references: [id])
  anyCountry             Boolean   @default(false)
  /// Кузов и тоннаж из регистрации (045 п.5) — предпочтение для ленты и «Кто
  /// свободен», пока в гараже нет настоящей машины; машины при регистрации не создаются.
  preferredBodyTypeId    String?
  preferredBodyType      BodyType? @relation("DriverPreferredBodyType", fields: [preferredBodyTypeId], references: [id])
  preferredCapacityTons  Decimal?  @db.Decimal(6, 2)
  /// 048 п.7: «основа» кузова из регистрации по профилю (литры, места, контейнеры).
  preferredSpecs         Json?
  /// ФИО из водительского удостоверения (045 п.10) — при регистрации водитель
  /// пишет только имя; после одобрения прав предлагаем подставить полное ФИО.
  licenseFullName        String?
  /// 054: фото профиля — отдельный объект в приватном бакете (миниатюра
  /// ~200 px), ставится только с согласия водителя; селфи проверки — не оно.
  avatarFileKey          String?
  /// Версия фото для кэша клиентов (меняется при смене/удалении).
  avatarUpdatedAt        DateTime?
  /// «Не сейчас» на предложении поставить селфи в профиль — больше не предлагаем.
  avatarOfferDismissedAt DateTime?
  isVerified             Boolean   @default(false)
  ratingAvg              Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount            Int       @default(0)
  /// 049 п.9: штраф за отмены, пока отзывов нет (ratingCount = 0), — копится
  /// и применяется к среднему с первым отзывом.
  pendingPenalty         Decimal   @default(0) @db.Decimal(6, 2)
  currentLat             Decimal?  @db.Decimal(9, 6)
  currentLng             Decimal?  @db.Decimal(9, 6)
  locationUpdatedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  directions            DriverDirection[]
  permits               DriverPermit[]
  vehicles              Vehicle[]
  arrivals              Arrival[]
  responses             Response[]
  deals                 Deal[]
  chats                 Chat[]
  contactEvents         ContactEvent[]
  verificationDocuments VerificationDocument[] @relation("DriverVerificationDocuments")
  payments              Payment[]

  @@index([homeCityId])
  @@map("drivers")
}

model DriverDirection {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  /// Области внутри страны (045 п.7); пусто — вся страна.
  regionIds String[] @default([])
  createdAt DateTime @default(now())

  @@unique([driverId, countryId])
  @@map("driver_directions")
}

model DriverPermit {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  permitId  String
  permit    Permit   @relation(fields: [permitId], references: [id])
  createdAt DateTime @default(now())

  @@unique([driverId, permitId])
  @@map("driver_permits")
}

model Vehicle {
  id           String          @id @default(uuid())
  driverId     String
  driver       Driver          @relation(fields: [driverId], references: [id])
  kind         VehicleKind
  /// Кузов/тоннаж/длина — только у TRAILER и RIGID (решение 2026-10-05,
  /// «Несколько машин: гараж»); у TRACTOR всегда null.
  bodyTypeId   String?
  bodyType     BodyType?       @relation(fields: [bodyTypeId], references: [id])
  plateNumber  String?
  vin          String?
  brand        String?
  capacityTons Decimal?        @db.Decimal(6, 2)
  lengthM      Decimal?        @db.Decimal(5, 2)
  /// Размер кузова (задача 033) — только TRAILER/RIGID. При выборе шаблона
  /// значения КОПИРУЮТСЯ из него (правка шаблона не меняет задним числом
  /// чужие машины); «Свой размер» — ввод Д/Ш/В, объём и паллеты считаются.
  sizePresetId String?
  sizePreset   BodySizePreset? @relation(fields: [sizePresetId], references: [id])
  innerLengthM Decimal?        @db.Decimal(5, 2)
  innerWidthM  Decimal?        @db.Decimal(4, 2)
  innerHeightM Decimal?        @db.Decimal(4, 2)
  volumeM3     Decimal?        @db.Decimal(6, 1)
  palletsEuro  Int?
  /// 048: параметры по профилю кузова (литры, продукт, места под машины…);
  /// у объёмных — проекция и в колонки volumeM3/palletsEuro/inner*.
  specs        Json?
  /// Водитель — собственник или работает на чужой машине.

  isOwner    Boolean          @default(true)
  /// Техпаспорт одобрен (ставится при approve соответствующего документа,
  /// см. admin.service.ts) — отдельно от Driver.isVerified (селфи+права).
  isVerified Boolean          @default(false)
  /// 044 п.6: ADMIN — одобрил админ, AUTO — автопроверка (VIN/госномер прошли
  /// формат, контрольную цифру и чёрный список); админ может отозвать.
  verifiedBy VehicleVerifier?
  verifiedAt DateTime?
  isActive   Boolean          @default(true)
  isArchived Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  verificationDocuments VerificationDocument[] @relation("VehicleVerificationDocuments")
  arrivalsAsTractor     Arrival[]              @relation("ArrivalTractor")
  arrivalsAsTrailer     Arrival[]              @relation("ArrivalTrailer")
  dealsAsTractor        Deal[]                 @relation("DealTractor")
  dealsAsTrailer        Deal[]                 @relation("DealTrailer")

  @@index([driverId])
  @@index([bodyTypeId])
  @@map("vehicles")
}

model Company {
  id              String    @id @default(uuid())
  name            String
  nameRu          String?
  countryId       String
  country         Country   @relation(fields: [countryId], references: [id])
  city            String?
  legalAddress    String?
  taxId           String?
  /// Вебхук группового бота WeCom (задача 011, п.2) — владелец вставляет
  /// адрес в профиле компании; «Проверить» шлёт туда тестовое сообщение.
  wecomWebhookUrl String?
  isVerified      Boolean   @default(false)
  /// 058 п.8а: грузовладелец / экспедитор / перевозчик — метка в карточке.
  kind            CompanyKind @default(FORWARDER)
  /// Оферта для компании (043 п.2) принята при регистрации — версия текста
  /// `/legal/offer`; у компаний до 043 — null.
  offerAcceptedAt DateTime?
  offerVersion    String?
  /// Блокировка компании целиком (задача 026, п.5) — отдельно от
  /// User.isBlocked у каждого сотрудника: блокировка компании блокирует
  /// всех её участников И скрывает активные грузы из ленты водителя.
  isBlocked       Boolean   @default(false)
  ratingAvg       Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount     Int       @default(0)
  /// 049 п.9: см. Driver.pendingPenalty.
  pendingPenalty  Decimal   @default(0) @db.Decimal(6, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members               CompanyMember[]
  cargos                Cargo[]
  deals                 Deal[]
  chats                 Chat[]
  contactEvents         ContactEvent[]
  arrivalViews          ArrivalView[]
  invites               CompanyInvite[]
  verificationDocuments VerificationDocument[] @relation("CompanyVerificationDocuments")
  subscriptions         Subscription[]
  payments              Payment[]

  @@index([countryId])
  @@map("companies")
}

model CompanyMember {
  id           String            @id @default(uuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id])
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  role         CompanyMemberRole
  /// Контакты конкретного сотрудника (задача 012) — водитель звонит/пишет
  /// логисту, опубликовавшему груз, а не «компании» (decisions.md
  /// «Компания: проверка, роли, контакты»). null у сотрудников, которые
  /// ещё не заполнили «Мой профиль» — тогда показываем company.name/
  /// User.phone как раньше (см. резолв контакта в cargos/chats).
  fullName     String?
  contactPhone String?
  wechatId     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([companyId])
  @@map("company_members")
}

/// Приглашение сотрудника по ссылке (задача 025, «Путь Б» из 022): владелец
/// отправляет email+роль, получает одноразовый токен, действующий 7 дней.
/// Переход по ссылке подтверждает email автоматически.
model CompanyInvite {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  invitedByUserId String
  invitedBy       User              @relation(fields: [invitedByUserId], references: [id])
  email           String
  role            CompanyMemberRole
  token           String            @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime          @default(now())

  @@index([companyId])
  @@index([token])
  @@map("company_invites")
}

// ---------------------------------------------------------------------------
// Груз и сделки
// ---------------------------------------------------------------------------

/// Анонс прибытия (задача 015 — ядро продукта): водитель сообщает, что
/// будет на точке в будущем (`plannedAt`, до +14 дней), не только «сейчас».
/// Один активный (PLANNED/ON_SITE) анонс на водителя — новый вызов
/// announce() заменяет предыдущий, а не плодит дубли.
model Arrival {
  id              String        @id @default(uuid())
  driverId        String
  driver          Driver        @relation(fields: [driverId], references: [id])
  pointId         String
  point           Point         @relation(fields: [pointId], references: [id])
  plannedAt       DateTime
  /// Календарный день приезда, выбранный водителем (задача 041, п.5): день
  /// без времени и часового пояса — группировка «Кто свободен» идёт по нему.
  plannedDay      DateTime      @db.Date
  arrivedAt       DateTime?
  /// Правило свежести (задача 040): когда водитель последний раз ответил
  /// «Да, ищу» / «Я на месте»; когда ему отправили напоминание «Доехали?»
  /// (день приезда) и «Ещё ищете груз?» (каждые 12 ч на месте).
  lastConfirmedAt DateTime?
  dayAskedAt      DateTime?
  staleAskedAt    DateTime?
  waitDays        Int           @default(2)
  anyCountry      Boolean       @default(false)
  status          ArrivalStatus @default(PLANNED)
  /// Связка на эту поездку (задача 031, этап A) — для RIGID используется
  /// только tractorId (сама машина), trailerId остаётся null.
  tractorId       String?
  tractor         Vehicle?      @relation("ArrivalTractor", fields: [tractorId], references: [id])
  trailerId       String?
  trailer         Vehicle?      @relation("ArrivalTrailer", fields: [trailerId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  directions ArrivalDirection[]
  views      ArrivalView[]

  @@index([driverId])
  @@index([pointId, status])
  @@index([status, plannedAt])
  @@map("arrivals")
}

/// Страны на конкретную поездку (п. 12 задачи 015) — может отличаться от
/// постоянных направлений в профиле водителя (`DriverDirection`).
model ArrivalDirection {
  id        String  @id @default(uuid())
  arrivalId String
  arrival   Arrival @relation(fields: [arrivalId], references: [id])
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  @@unique([arrivalId, countryId])
  @@map("arrival_directions")
}

/// Счётчик «N логистов посмотрели» (п. 8 задачи 015) — уникальные компании,
/// не количество открытий.
model ArrivalView {
  id        String   @id @default(uuid())
  arrivalId String
  arrival   Arrival  @relation(fields: [arrivalId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  viewedAt  DateTime @default(now())

  @@unique([arrivalId, companyId])
  @@map("arrival_views")
}

/// Настройки приложения уровня ключ-значение, редактируются в админке
/// (задача 015: `defaultPointCityId`). Значение — всегда строка; парсинг на
/// стороне использующего кода.
model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Идентификаторы и чёрный список (задача 031, этап C)
// ---------------------------------------------------------------------------

enum IdentifierType {
  IIN
  DRIVER_LICENSE_NO
  VIN
  PLATE
  BIN
  USCC
  PHONE
}

enum IdentifierOwnerType {
  DRIVER
  COMPANY
  VEHICLE
}

/// Подтверждённое значение идентификатора одного владельца (решение
/// 2026-10-05 «Распознавание документов и чёрный список»). valueHash —
/// HMAC-SHA256 нормализованного значения (IDENTIFIER_PEPPER) для поиска
/// совпадений без хранения открытого текста; valueEncrypted — AES-256-GCM
/// (IDENTIFIER_KEY), только для IIN/DRIVER_LICENSE_NO — остальные типы не
/// настолько чувствительны, чтобы прятать даже от админа. Один владелец —
/// одно подтверждённое значение на тип (новое подтверждение перезаписывает
/// старое, например при смене госномера).
model Identifier {
  id                String                @id @default(uuid())
  type              IdentifierType
  valueHash         String
  valueMasked       String
  valueEncrypted    String?
  ownerType         IdentifierOwnerType
  ownerId           String
  sourceDocumentId  String?
  sourceDocument    VerificationDocument? @relation(fields: [sourceDocumentId], references: [id])
  confirmedByUserId String?
  confirmedBy       User?                 @relation("IdentifierConfirmedBy", fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([ownerType, ownerId, type])
  @@index([type, valueHash])
  @@map("identifiers")
}

/// Чёрный список по значению, не по аккаунту (решение 2026-10-05) —
/// переживает удаление/замену владельца. sourceOwnerType/sourceOwnerId —
/// чей блок изначально породил эту запись (для снятия блокировки пачкой
/// при разблокировке того же водителя/компании); сама запись может
/// заблокировать и ДРУГОГО владельца, который позже заявит тот же
/// идентификатор — в этом и смысл.
model BlockedIdentifier {
  id              String               @id @default(uuid())
  type            IdentifierType
  valueHash       String
  valueMasked     String
  reason          String
  blockedByUserId String
  blockedBy       User                 @relation("IdentifierBlockedBy", fields: [blockedByUserId], references: [id])
  sourceOwnerType IdentifierOwnerType?
  sourceOwnerId   String?
  createdAt       DateTime             @default(now())
  liftedAt        DateTime?
  liftedByUserId  String?
  liftedBy        User?                @relation("IdentifierLiftedBy", fields: [liftedByUserId], references: [id])
  liftReason      String?

  @@index([type, valueHash])
  @@index([sourceOwnerType, sourceOwnerId])
  @@map("blocked_identifiers")
}

enum DocumentRecognitionStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

/// Задача 031, этап D — результат распознавания одного документа. Один на
/// документ (повторный прогон перезаписывает) — поэтому documentId
/// уникален, а не просто индексирован. `fields` — JSON вида
/// `{iin: {value, confidence, checksumOk, needsReview}, ...}`, набор
/// ключей зависит от типа документа (п.20). Только ПОМОГАЕТ админу —
/// в identifiers значения попадают лишь после его подтверждения
/// (reviewVerificationDocument/admin-ручной ввод, не отсюда напрямую).
model DocumentRecognition {
  id            String                    @id @default(uuid())
  documentId    String                    @unique
  document      VerificationDocument      @relation(fields: [documentId], references: [id])
  status        DocumentRecognitionStatus @default(PENDING)
  fields        Json?
  engineVersion String?
  durationMs    Int?
  errorMessage  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@map("document_recognitions")
}

model Cargo {
  id                   String             @id @default(uuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id])
  /// Логист, опубликовавший груз (decisions.md «Компания: проверка, роли,
  /// контакты», задача 012: «водитель звонит конкретному логисту, а не
  /// компании») — водитель видит и звонит именно ему, не владельцу
  /// компании. `NULL` у грузов, опубликованных до задачи 017 — на чтении
  /// падаем на владельца компании.
  publishedByUserId    String?
  publishedBy          User?              @relation("CargoPublishedBy", fields: [publishedByUserId], references: [id])
  pointId              String
  point                Point              @relation(fields: [pointId], references: [id])
  destinationCountryId String
  destinationCountry   Country            @relation(fields: [destinationCountryId], references: [id])
  destinationCityId    String?
  destinationCity      City?              @relation(fields: [destinationCityId], references: [id])
  bodyTypeId           String
  bodyType             BodyType           @relation(fields: [bodyTypeId], references: [id])
  weightKg             Decimal?           @db.Decimal(10, 2)
  volumeM3             Decimal?           @db.Decimal(7, 2)
  /// Паллеты (задача 033) — логист может указать вместо/вместе с объёмом.
  palletCount          Int?
  /// 048: другие подходящие кузова (кроме основного bodyTypeId) и параметры
  /// груза по профилю (продукт и литры, тип контейнера, число машин…).
  extraBodyTypeIds     String[]           @default([])
  specs                Json?
  photoUrls            String[]           @default([])
  /// 047: категория груза (справочник), обязательна при публикации.
  categoryId           String
  category             CargoCategory      @relation(fields: [categoryId], references: [id])
  /// 047: расстояние по дороге (OSRM, кэш пар городов) и цена за км в валюте
  /// груза; `NULL` — нет города назначения или OSRM был недоступен.
  distanceKm           Int?
  pricePerKm           Decimal?           @db.Decimal(12, 2)
  price                Decimal            @db.Decimal(12, 2)
  currency             Currency
  /// 058 п.1: условия оплаты — аванс (в валюте груза), форма, отсрочка в днях.
  advanceAmount        Decimal?           @db.Decimal(12, 2)
  paymentForm          PaymentForm?
  paymentDelayDays     Int?
  /// 058 п.2: сколько машин нужно (1–20). Груз в поиске, пока сделок (кроме
  /// отменённых) меньше этого числа; каждый выбор водителя — своя сделка.
  trucksNeeded         Int                @default(1)
  readyDate            DateTime           @db.Date
  /// «Можно догрузом» (задача 040, п.6): груз не на всю машину, сборный.
  allowPartial         Boolean            @default(false)
  description          String?
  status               CargoStatus        @default(PUBLISHED)
  publishedAt          DateTime           @default(now())
  expiresAt            DateTime
  archivedAt           DateTime?
  /// Исход закрытия (задача 017, п.6/7) — метрика утечки сделок мимо
  /// приложения, тот же смысл, что у аналогичной метрики анонсов (014).
  closeOutcome         CargoCloseOutcome?
  closedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  responses     Response[]
  deals         Deal[]
  chats         Chat[]
  contactEvents ContactEvent[]

  responsesSeen CargoResponsesSeen[]

  @@index([status, pointId, destinationCountryId])
  @@index([companyId])
  @@map("cargos")
}

/// Категория груза (047 п.1): стройматериалы, продукты, оборудование… —
/// справочник, правится в админке без релиза.
model CargoCategory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cargos Cargo[]

  @@map("cargo_categories")
}

/// Расстояние по дороге между городами (047 п.2) — пара хранится один раз
/// (fromCityId < toCityId), считается OSRM.
model CityDistance {
  fromCityId String
  toCityId   String
  km         Int
  source     String   @default("osrm")
  computedAt DateTime @default(now())

  @@id([fromCityId, toCityId])
  @@map("city_distances")
}

enum PricePointKind {
  LISTED
  DEAL
}

/// Точка статистики цен (047 п.4): объявление проверенной компании или сделка.
model PricePoint {
  id            String         @id @default(uuid())
  kind          PricePointKind
  cargoId       String
  dealId        String?
  driverId      String?
  companyId     String
  fromCityId    String
  toCityId      String
  /// KZ / CIS / CN_FAR — по стране назначения.
  bucket        String
  /// 5 / 10 / 20 — класс тоннажа.
  tonnageClass  Int
  pricePerKmKzt Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())

  @@index([fromCityId, toCityId, bucket, tonnageClass, createdAt])
  @@map("price_points")
}

/// Медиана и P25–P75 ₸/км за 30 дней (047 п.4), пересчёт раз в сутки.
model RoutePriceStat {
  fromCityId   String
  toCityId     String
  bucket       String
  tonnageClass Int
  median       Decimal  @db.Decimal(12, 2)
  p25          Decimal  @db.Decimal(12, 2)
  p75          Decimal  @db.Decimal(12, 2)
  points       Int
  dealPoints   Int
  computedAt   DateTime

  @@id([fromCityId, toCityId, bucket, tonnageClass])
  @@map("route_price_stats")
}

model Response {
  id          String               @id @default(uuid())
  cargoId     String
  cargo       Cargo                @relation(fields: [cargoId], references: [id])
  driverId    String
  driver      Driver               @relation(fields: [driverId], references: [id])
  message     String?
  status      ResponseStatus       @default(PENDING)
  closeReason ResponseCloseReason?
  /// 058 п.5: своя цена водителя (в валюте груза) и комментарий; один
  /// встречный ход логиста — counterPrice и ответ водителя на него.
  proposedPrice   Decimal?        @db.Decimal(12, 2)
  proposedComment String?
  counterPrice    Decimal?        @db.Decimal(12, 2)
  counterStatus   CounterStatus?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  deal Deal?

  @@unique([cargoId, driverId])
  @@index([cargoId])
  @@map("responses")
}

model Deal {
  id                      String            @id @default(uuid())
  /// 057 п.3: у отменённой сделки — null: отклик свободен, водителя можно выбрать снова.
  responseId              String?           @unique
  response                Response?         @relation(fields: [responseId], references: [id])
  cargoId                 String
  cargo                   Cargo             @relation(fields: [cargoId], references: [id])
  driverId                String
  driver                  Driver            @relation(fields: [driverId], references: [id])
  companyId               String
  company                 Company           @relation(fields: [companyId], references: [id])
  /// 058 п.5: итоговая цена (в валюте груза) — цена груза, своя цена водителя
  /// или принятая встречная; статистика цен — по ней.
  agreedPrice             Decimal?          @db.Decimal(12, 2)
  /// Связка машин на этот рейс (задача 031, этап A) — снимок с актуальной
  /// заявки водителя на момент создания сделки; null — старые сделки до
  /// миграции 031 или водитель без заявки на точке (проверка по связке
  /// тогда пропускается, см. deals.service.ts).
  tractorId               String?
  tractor                 Vehicle?          @relation("DealTractor", fields: [tractorId], references: [id])
  trailerId               String?
  trailer                 Vehicle?          @relation("DealTrailer", fields: [trailerId], references: [id])
  status                  DealStatus        @default(SELECTED)
  cancelReason            String?
  /// Код причины отмены (задача 038, п.15) — «Взял другой груз» и т.п.
  /// хранится кодом (TOOK_OTHER_CARGO), не переведённой строкой — иначе
  /// статистику по причинам не посчитать.
  cancelReasonCode        String?
  cancelledByRole         ReviewAuthorRole?
  /// 046: этап и сторона вины отмены (вес в рейтинге и статистике).
  cancelStage             CancelStage?
  faultSide               FaultSide?
  /// 046: запрос отмены после «В пути» — кто, почему, когда; позиция второй стороны в споре.
  cancelRequestedAt       DateTime?
  cancelRequestedByRole   ReviewAuthorRole?
  cancelRequestReasonCode String?
  cancelRequestReason     String?
  disputeReason           String?
  disputedAt              DateTime?
  confirmedAt             DateTime?
  loadedAt                DateTime?
  inTransitAt             DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  contactEvents ContactEvent[]
  chats         Chat[]
  reviews       Review[]
  payments      Payment[]

  @@index([status])
  @@index([driverId])
  @@index([companyId])
  @@map("deals")
}

model ContactEvent {
  id          String           @id @default(uuid())
  driverId    String
  driver      Driver           @relation(fields: [driverId], references: [id])
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  cargoId     String?
  cargo       Cargo?           @relation(fields: [cargoId], references: [id])
  dealId      String?
  deal        Deal?            @relation(fields: [dealId], references: [id])
  actorUserId String
  actor       User             @relation("ContactEventActor", fields: [actorUserId], references: [id])
  type        ContactEventType
  createdAt   DateTime         @default(now())

  @@index([driverId])
  @@index([companyId])
  @@map("contact_events")
}

model Chat {
  id            String   @id @default(uuid())
  cargoId       String?
  cargo         Cargo?   @relation(fields: [cargoId], references: [id])
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id])
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  /// Логист, начавший чат без груза (041, п.9): собеседник водителя — он, а не
  /// случайный владелец компании.
  companyUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([driverId, companyId, cargoId])
  @@index([driverId])
  @@index([companyId])
  @@map("chats")
}

/// Автоперевод (задача 010) — SKIPPED: не нужен (получатель пишет на том
/// же языке), DONE: перевод(ы) в `translations`, FAILED: провайдер
/// недоступен/таймаут — сообщение доставлено с оригиналом, клиент
/// показывает «Перевод недоступен · повторить».
enum TranslationStatus {
  SKIPPED
  /// В очереди/переводится в фоне (задача 029, п.6) — сообщение уже
  /// доставлено с оригиналом, перевод подъедет отдельным событием
  /// `message:translated`, отправка не ждёт DeepSeek.
  PENDING
  DONE
  FAILED
}

/// Системные сообщения (задача 038, п.11) — события «водитель готов
/// взять», «выбран водитель», «перевозка подтверждена» и т.п. не идут от
/// имени нажавшего: kind=SYSTEM, текст строится НА КЛИЕНТЕ из ARB по
/// systemCode+systemParams на языке читателя (моделью не переводится,
/// translationStatus=SKIPPED). originalText — русский фолбэк для админки
/// и старых клиентов.
enum MessageKind {
  USER
  SYSTEM
}

model Message {
  id                String            @id @default(uuid())
  chatId            String
  chat              Chat              @relation(fields: [chatId], references: [id])
  senderUserId      String
  sender            User              @relation(fields: [senderUserId], references: [id])
  kind              MessageKind       @default(USER)
  systemCode        String?
  systemParams      Json?
  originalText      String
  originalLang      Locale
  translations      Json?
  translationStatus TranslationStatus @default(SKIPPED)
  isRead            Boolean           @default(false)
  createdAt         DateTime          @default(now())

  @@index([chatId, createdAt])
  @@map("messages")
}

/// Метрика расхода (задача 010, п.8) — «Настройки → Перевод» в админке:
/// включён/выключен, модель, расход за 7 дней. Одна строка на один вызов
/// провайдера (не на сообщение — ретрай пишет вторую строку).
model TranslationLog {
  id         String   @id @default(uuid())
  provider   String
  model      String?
  success    Boolean
  tokensUsed Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("translation_logs")
}

model Review {
  id           String           @id @default(uuid())
  dealId       String
  deal         Deal             @relation(fields: [dealId], references: [id])
  authorUserId String
  author       User             @relation(fields: [authorUserId], references: [id])
  authorRole   ReviewAuthorRole
  rating       Int
  comment      String?
  createdAt    DateTime         @default(now())

  @@unique([dealId, authorRole])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Верификация, уведомления, жалобы, курсы, аудит, монетизация
// ---------------------------------------------------------------------------

model VerificationDocument {
  id               String              @id @default(uuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  driverId         String?
  driver           Driver?             @relation("DriverVerificationDocuments", fields: [driverId], references: [id])
  companyId        String?
  company          Company?            @relation("CompanyVerificationDocuments", fields: [companyId], references: [id])
  /// Техпаспорт конкретной машины гаража (задача 031, этап A) — VEHICLE_PASSPORT/
  /// TRAILER_PASSPORT принадлежат машине, не только водителю.
  vehicleId        String?
  vehicle          Vehicle?            @relation("VehicleVerificationDocuments", fields: [vehicleId], references: [id])
  type             VerificationDocType
  fileUrl          String
  status           VerificationStatus  @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?               @relation("VerificationDocumentReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  rejectReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  identifiersSourced Identifier[]
  recognition        DocumentRecognition?

  @@index([userId])
  @@index([companyId])
  @@index([vehicleId])
  @@map("verification_documents")
}

model NotificationSetting {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel])
  @@map("notification_settings")
}

/// Группа событий (задача 011, п.4) — отдельная ось от NotificationSetting:
/// там "включён ли канал вообще" (push/wecom/email/sms), здесь "хочу ли я
/// именно эти уведомления". notify() шлёт, только если ОБЕ оси включены
/// (или для оси, по которой строки ещё нет — дефолт true у обеих).
enum NotificationEventGroup {
  NEW_CARGO_MATCH
  CARGO_INVITE
  CHAT_MESSAGE
  NEW_RESPONSE
  NEW_DRIVER_DIGEST
  DEAL_STATUS
  VERIFICATION
  AGREED_CHECK
  /// Напоминания о свежести анонса «Доехали?» / «Ещё ищете груз?» (задача 040).
  ARRIVAL_CHECK
  /// Снятие груза/решение по жалобе админом (задача 029, п.7) — раньше
  /// только NOTIFICATION_QUEUED в audit_log без реальной отправки.
  ADMIN_ACTION
}

model NotificationEventSetting {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id])
  eventGroup NotificationEventGroup
  enabled    Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([userId, eventGroup])
  @@map("notification_event_settings")
}

enum DevicePlatform {
  FCM
  APNS
  JPUSH
}

/// Токен устройства для push (задача 011, п.2) — привязан к пользователю,
/// не к Session из 006: сессия живёт 15 мин/до логаута, токен устройства
/// переживает много сессий, обновляется при каждом запуске приложения.
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
  @@map("device_tokens")
}

model Complaint {
  id               String               @id @default(uuid())
  reporterUserId   String
  reporter         User                 @relation("ComplaintReporter", fields: [reporterUserId], references: [id])
  targetType       ComplaintTargetType
  targetId         String
  reason           String
  description      String?
  status           ComplaintStatus      @default(OPEN)
  /// Кто взял в работу (задача 028, п.24e) — отдельно от resolvedByUserId,
  /// который ставится только при закрытии.
  assignedToUserId String?
  assignedTo       User?                @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id])
  takenAt          DateTime?
  resolvedByUserId String?
  resolvedBy       User?                @relation("ComplaintResolver", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  /// Решение (п.24b) — `NULL` у старых записей, закрытых до этой миграции.
  resolution       ComplaintResolution?
  /// Ответ автору жалобы — обязателен при закрытии (п.24d), `NULL` у старых.
  resolutionNote   String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([targetType, targetId])
  @@map("complaints")
}

enum ComplaintResolution {
  DISMISSED
  WARNED
  CARGO_UNPUBLISHED
  BLOCKED
}

model ExchangeRate {
  id            String   @id @default(uuid())
  currency      Currency
  rateToKzt     Decimal  @db.Decimal(12, 6)
  effectiveDate DateTime @db.Date
  source        String   @default("nbrk")
  createdAt     DateTime @default(now())

  @@unique([currency, effectiveDate])
  @@map("exchange_rates")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_log")
}

model Subscription {
  id        String             @id @default(uuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  plan      String             @default("company_monthly")
  priceUsd  Decimal            @default(200) @db.Decimal(8, 2)
  status    SubscriptionStatus @default(TRIAL)
  startedAt DateTime           @default(now())
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments Payment[]

  @@index([companyId])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id])
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       Currency      @default(USD)
  type           PaymentType
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([driverId])
  @@map("payments")
}

/// 056 п.5: когда сотрудник компании последний раз открывал отклики груза —
/// «новые» отклики (PENDING позже этой отметки) у каждого сотрудника свои.
model CargoResponsesSeen {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cargoId String
  cargo   Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  seenAt  DateTime @default(now())

  @@id([userId, cargoId])
  @@index([cargoId])
  @@map("cargo_responses_seen")
}

/// 052: «Поделиться» — что именно (груз, все грузы компании, анонс водителя).
enum ShareType {
  CARGO
  COMPANY
  DRIVER
}

/// 052: короткая ссылка `/c|co|d/<код>`; автор — кто поделился (за ним
/// считаются открытия, входы по ссылке, отклики и сделки пришедших).
model ShareLink {
  id           String    @id @default(uuid())
  code         String    @unique
  type         ShareType
  targetId     String
  authorUserId String
  author       User      @relation("ShareLinkAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  opens        Int       @default(0)
  logins       Int       @default(0)
  responses    Int       @default(0)
  deals        Int       @default(0)
  createdAt    DateTime  @default(now())
  referred     User[]    @relation("ShareLinkReferred")

  @@unique([authorUserId, type, targetId])
  @@index([type, targetId])
  @@map("share_links")
}
